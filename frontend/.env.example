# Recomendado: dejar VITE_API_URL vacío para usar /api.
# En local Vite proxyea /api; en Vercel vercel.json hace el rewrite al backend.
# No pongas http://3.113.33.9:8002 como VITE_API_URL desde una web HTTPS:
# el navegador lo bloqueará como mixed content.
VITE_API_URL=

# Opcional para desarrollo local: cambia el destino del proxy de Vite.
# Si levantas el backend con docker-compose, usa http://localhost:8002
API_PROXY_TARGET=http://3.113.33.9:8002
